generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model fuel_transaction_attachments {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fuel_transaction_id String            @db.Uuid
  file_name           String            @db.VarChar(255)
  file_url            String
  file_type           String?           @db.VarChar(100)
  file_size_bytes     BigInt?
  uploaded_at         DateTime          @default(now()) @db.Timestamptz(6)
  fuel_transactions   fuel_transactions @relation(fields: [fuel_transaction_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fuel_attachment_transaction")

  @@index([fuel_transaction_id], map: "idx_fuel_attachments_transaction")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fuel_transactions {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicle_id                   String                         @db.Uuid
  quantity_liters              Decimal                        @db.Decimal(10, 2)
  cost                         Decimal?                       @db.Decimal(12, 2)
  odometer_km                  Decimal                        @db.Decimal(12, 2)
  refueled_at                  DateTime                       @default(now()) @db.Timestamptz(6)
  station_name                 String?                        @db.VarChar(150)
  source                       String                         @db.VarChar(30)
  reference_number             String?                        @db.VarChar(100)
  notes                        String?
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  fuel_transaction_attachments fuel_transaction_attachments[]
  vehicles                     vehicles                       @relation(fields: [vehicle_id], references: [id], onUpdate: NoAction, map: "fk_fuel_vehicle")

  @@index([refueled_at], map: "idx_fuel_transactions_refueled_at")
  @@index([vehicle_id], map: "idx_fuel_transactions_vehicle")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model maintenance_records {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicle_id            String    @db.Uuid
  maintenance_type      String    @db.VarChar(100)
  description           String?
  maintenance_date      DateTime  @db.Date
  odometer_km           Decimal   @db.Decimal(12, 2)
  cost                  Decimal   @default(0) @db.Decimal(12, 2)
  next_maintenance_date DateTime? @db.Date
  next_maintenance_km   Decimal?  @db.Decimal(12, 2)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)
  vehicles              vehicles  @relation(fields: [vehicle_id], references: [id], onUpdate: NoAction, map: "fk_maintenance_vehicle")

  @@index([maintenance_date], map: "idx_maintenance_date")
  @@index([next_maintenance_date], map: "idx_maintenance_next_date")
  @@index([next_maintenance_km], map: "idx_maintenance_next_km")
  @@index([vehicle_id], map: "idx_maintenance_vehicle")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model routes {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicle_id               String                   @db.Uuid
  name                     String                   @db.VarChar(150)
  start_location           Unsupported("geography")
  end_location             Unsupported("geography")
  allowed_deviation_meters Int                      @default(200)
  is_active                Boolean                  @default(true)
  created_at               DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                 @default(now()) @db.Timestamptz(6)
  vehicles                 vehicles                 @relation(fields: [vehicle_id], references: [id], onUpdate: NoAction, map: "fk_route_vehicle")

  @@index([end_location], map: "idx_routes_end_location", type: Gist)
  @@index([start_location], map: "idx_routes_start_location", type: Gist)
  @@index([vehicle_id], map: "idx_routes_vehicle")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vehicles {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plateNumber         String                @unique @db.VarChar(50)
  brand               String                @db.VarChar(100)
  model               String?               @db.VarChar(100)
  departmentId        String?               @db.Uuid
  fuelType            String?               @db.VarChar(50)
  tankCapacity        Decimal?              @db.Decimal(10, 2)
  expectedConsumption Decimal?              @db.Decimal(10, 2)
  isActive            Boolean               @default(true)
  region              String?               @db.VarChar(100)
  liveTrackUrl        String?
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @db.Timestamptz(6)
  fuel_transactions   fuel_transactions[]
  maintenance_records maintenance_records[]
  routes              routes[]
}
